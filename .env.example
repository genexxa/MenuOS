# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (Project Settings > API). Ne jamais commiter .env.local.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Utilisée uniquement côté serveur (Edge Functions), jamais exposée au frontend.
# À définir via `supabase secrets set` — ne pas préfixer par VITE_.
# ANTHROPIC_API_KEY=
